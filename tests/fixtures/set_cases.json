{
  "about": [
    "POST /gameday/set requests and the settings they leave in /gameday/state.",
    "Checked against the firmware's parser (components/gameday/set_request.h) by test_set.cpp",
    "and against tests/web/mock_device.py by its --selftest, so the page's mock can't drift.",
    "Each case starts from base plus its own start, sends set (key, value pairs, applied in",
    "kSetKeys order) and compares the keys in expect. Teams are written league:id, \"\" for none.",
    "status 400: no key in the request is one the firmware takes, so nothing changes.",
    "The panel keeps the saved team's league byte after the team is cleared, and a fresh panel's",
    "is NFL, so Live auto counts that league too (team_league in start sets it)."
  ],
  "base": {
    "team": "nfl:6", "team_league": "nfl", "mode": 0, "rotate": 1, "lockon": 15, "release": 30, "collide": 0,
    "favs": ["", "", "", ""], "lists": [], "list": 0, "today": false, "jump": false, "banner": true, "favtake": false, "live": [], "live_auto": true, "tz": 1, "tz_auto": true,
    "down": true, "count": true, "match": true, "play": true, "odds": true, "leaders": true, "opp": true, "best": true, "bootaddr": true,
    "autoupd": false, "beta": false, "panels": 1, "msg": "", "msgurl": "", "msgevery": 2,
    "night": false, "nightstart": "23:00", "nightend": "07:00", "nightscreen": true, "nightlevel": 16
  },
  "cases": [
    {"name": "mode 5 is Live games", "set": [["mode", "5"]], "expect": {"mode": 5}},
    {"name": "mode past Live games is refused", "set": [["mode", "6"]], "expect": {"mode": 0}},
    {"name": "negative mode is refused", "start": {"mode": 4}, "set": [["mode", "-1"]], "expect": {"mode": 4}},
    {"name": "mode reads like atoi, so text is My team", "start": {"mode": 4}, "set": [["mode", "abc"]], "expect": {"mode": 0}},

    {"name": "rotate in range", "set": [["rotate", "15"]], "expect": {"rotate": 15}},
    {"name": "rotate below 1 clamps up", "start": {"rotate": 10}, "set": [["rotate", "0"]], "expect": {"rotate": 1}},
    {"name": "rotate above 30 clamps down", "set": [["rotate", "31"]], "expect": {"rotate": 30}},
    {"name": "empty rotate is the minimum", "start": {"rotate": 10}, "set": [["rotate", ""]], "expect": {"rotate": 1}},

    {"name": "lockon in range", "set": [["lockon", "60"]], "expect": {"lockon": 60}},
    {"name": "lockon below 5 clamps up", "set": [["lockon", "4"]], "expect": {"lockon": 5}},
    {"name": "lockon above 120 clamps down", "set": [["lockon", "121"]], "expect": {"lockon": 120}},

    {"name": "release in range", "set": [["release", "600"]], "expect": {"release": 600}},
    {"name": "release below 30 clamps up", "start": {"release": 600}, "set": [["release", "29"]], "expect": {"release": 30}},
    {"name": "release above 3600 clamps down", "set": [["release", "3601"]], "expect": {"release": 3600}},

    {"name": "collide on", "set": [["collide", "1"]], "expect": {"collide": 1}},
    {"name": "switches are on for 1 only", "start": {"collide": 1, "today": true}, "set": [["collide", "true"], ["today", "yes"]], "expect": {"collide": 0, "today": false}},
    {"name": "today on", "set": [["today", "1"]], "expect": {"today": true}},
    {"name": "ticker and boot switches off", "set": [["down", "0"], ["play", "0"], ["odds", "0"], ["opp", "0"], ["bootaddr", "0"], ["tzauto", "0"]],
     "expect": {"down": false, "play": false, "odds": false, "opp": false, "bootaddr": false, "tz_auto": false}},
    {"name": "best game off", "set": [["best", "0"]], "expect": {"best": false}},
    {"name": "jump to the action on, score banner off", "set": [["jump", "1"], ["banner", "0"]], "expect": {"jump": true, "banner": false}},
    {"name": "pre-game leaders off", "set": [["leaders", "0"]], "expect": {"leaders": false}},
    {"name": "pre-game leaders back on", "start": {"leaders": false}, "set": [["leaders", "1"]], "expect": {"leaders": true}},
    {"name": "jump and banner back", "start": {"jump": true, "banner": false}, "set": [["jump", "0"], ["banner", "1"]], "expect": {"jump": false, "banner": true}},
    {"name": "favorites take over on", "set": [["favtake", "1"]], "expect": {"favtake": true}},
    {"name": "favorites take over off", "start": {"favtake": true}, "set": [["favtake", "0"]], "expect": {"favtake": false}},
    {"name": "best game back on", "start": {"best": false}, "set": [["best", "1"]], "expect": {"best": true}},
    {"name": "each sport's situation switch is its own", "set": [["count", "0"]], "expect": {"down": true, "count": false, "match": true}},
    {"name": "soccer stats off, football and baseball stay on", "set": [["match", "0"]], "expect": {"down": true, "count": true, "match": false}},
    {"name": "football off leaves the others", "set": [["down", "0"]], "expect": {"down": false, "count": true, "match": true}},
    {"name": "automatic updates on", "set": [["autoupd", "1"]], "expect": {"autoupd": true}},
    {"name": "follow beta on", "set": [["beta", "1"]], "expect": {"beta": true, "autoupd": false}},
    {"name": "follow beta off", "start": {"beta": true}, "set": [["beta", "0"]], "expect": {"beta": false}},

    {"name": "tz by index", "set": [["tz", "3"]], "expect": {"tz": 3}},
    {"name": "tz by name", "set": [["tz", "US Eastern"]], "expect": {"tz": 0}},
    {"name": "tz by IANA zone", "set": [["tz", "America/Denver"]], "expect": {"tz": 2}},
    {"name": "tz index past the list is refused", "set": [["tz", "999"]], "expect": {"tz": 1}},
    {"name": "unknown tz is refused", "set": [["tz", "Mars/Olympus"]], "expect": {"tz": 1}},
    {"name": "empty tz is refused", "set": [["tz", ""]], "expect": {"tz": 1}},

    {"name": "team in another league", "set": [["team", "mlb:15"]], "expect": {"team": "mlb:15"}},
    {"name": "team none clears it", "set": [["team", "none"]], "expect": {"team": ""}},
    {"name": "unknown team id is refused", "set": [["team", "nfl:99999"]], "expect": {"team": "nfl:6"}},
    {"name": "unknown league is refused", "set": [["team", "xfl:6"]], "expect": {"team": "nfl:6"}},
    {"name": "team id 0 is refused", "set": [["team", "nfl:0"]], "expect": {"team": "nfl:6"}},
    {"name": "empty team is refused", "set": [["team", ""]], "expect": {"team": "nfl:6"}},

    {"name": "fav slot 1", "set": [["fav1", "mlb:15"]], "expect": {"favs": ["mlb:15", "", "", ""]}},
    {"name": "fav slot 4", "set": [["fav4", "nhl:25"]], "expect": {"favs": ["", "", "", "nhl:25"]}},
    {"name": "fav slot none clears it", "start": {"favs": ["mlb:15", "nfl:6", "", ""]}, "set": [["fav2", "none"]], "expect": {"favs": ["mlb:15", "", "", ""]}},
    {"name": "empty fav slot clears it", "start": {"favs": ["mlb:15", "nfl:6", "nhl:25", ""]}, "set": [["fav3", ""]], "expect": {"favs": ["mlb:15", "nfl:6", "", ""]}},
    {"name": "unknown fav team is refused", "start": {"favs": ["mlb:15", "nfl:6", "", ""]}, "set": [["fav2", "nfl:99999"]], "expect": {"favs": ["mlb:15", "nfl:6", "", ""]}},
    {"name": "garbage fav is refused", "start": {"favs": ["mlb:15", "nfl:6", "", ""]}, "set": [["fav2", "cowboys"]], "expect": {"favs": ["mlb:15", "nfl:6", "", ""]}},
    {"name": "fav slot 5 is not a key", "set": [["fav5", "mlb:15"]], "status": 400, "expect": {"favs": ["", "", "", ""]}},
    {"name": "fav slot 0 is not a key", "set": [["fav0", "mlb:15"]], "status": 400, "expect": {"favs": ["", "", "", ""]}},

    {"name": "favs list keeps order, drops repeats and unknowns",
     "set": [["favs", "mlb:15,nfl:6,mlb:15,bogus,nfl:99999,nhl:25"]], "expect": {"favs": ["mlb:15", "nfl:6", "nhl:25", ""]}},
    {"name": "empty favs clears the list", "start": {"favs": ["mlb:15", "nfl:6", "", "", "nhl:25"]}, "set": [["favs", ""]], "expect": {"favs": ["", "", "", ""]}},
    {"name": "favs past four show in full", "set": [["favs", "nfl:1,nfl:2,nfl:3,nfl:4,nfl:5,nfl:6"]],
     "expect": {"favs": ["nfl:1", "nfl:2", "nfl:3", "nfl:4", "nfl:5", "nfl:6"]}},
    {"name": "favs stop at sixteen",
     "set": [["favs", "nfl:1,nfl:2,nfl:3,nfl:4,nfl:5,nfl:6,nfl:7,nfl:8,nfl:9,nfl:10,nfl:11,nfl:12,nfl:13,nfl:14,nfl:15,nfl:16,nfl:17"]],
     "expect": {"favs": ["nfl:1", "nfl:2", "nfl:3", "nfl:4", "nfl:5", "nfl:6", "nfl:7", "nfl:8", "nfl:9", "nfl:10", "nfl:11", "nfl:12", "nfl:13", "nfl:14", "nfl:15", "nfl:16"]}},
    {"name": "favs applies after a fav slot in the same request", "set": [["favs", "nhl:25"], ["fav1", "mlb:15"]], "expect": {"favs": ["nhl:25", "", "", ""]}},

    {"name": "live list", "set": [["live", "mlb,nhl"]], "expect": {"live": ["mlb", "nhl"], "live_auto": false}},
    {"name": "live list comes back in league order", "set": [["live", "nhl,epl,mlb"]], "expect": {"live": ["mlb", "epl", "nhl"], "live_auto": false}},
    {"name": "live list skips unknown keys", "set": [["live", "nhl,xfl"]], "expect": {"live": ["nhl"], "live_auto": false}},
    {"name": "empty live puts auto back", "start": {"live": ["mlb"], "live_auto": false}, "set": [["live", ""]], "expect": {"live": ["nfl"], "live_auto": true}},
    {"name": "live of only unknown keys is auto", "start": {"live": ["mlb"], "live_auto": false}, "set": [["live", "MLB"]], "expect": {"live": ["nfl"], "live_auto": true}},

    {"name": "auto with no team and no favorites is NFL", "start": {"team": "", "team_league": "nfl", "mode": 5}, "set": [["live", ""]], "expect": {"live": ["nfl"], "live_auto": true}},
    {"name": "auto with the team only", "start": {"team": "mlb:15", "team_league": "mlb"}, "set": [["live", ""]], "expect": {"live": ["mlb"], "live_auto": true}},
    {"name": "auto adds favorites in other leagues", "start": {"favs": ["mlb:15", "nhl:25", "epl:359", ""]}, "set": [["live", ""]],
     "expect": {"live": ["nfl", "mlb", "epl", "nhl"], "live_auto": true}},
    {"name": "auto counts favorites past the fourth", "start": {"favs": ["nfl:1", "", "", "", "mcbb:2000"]}, "set": [["live", ""]], "expect": {"live": ["nfl", "mcbb"], "live_auto": true}},
    {"name": "auto follows a favorites change", "set": [["favs", "nhl:25"]], "expect": {"live": ["nfl", "nhl"], "live_auto": true}},
    {"name": "an explicit list ignores the team and favorites", "start": {"favs": ["mlb:15", "", "", ""]}, "set": [["live", "nhl"]], "expect": {"live": ["nhl"], "live_auto": false}},
    {"name": "a cleared team's league stays in auto", "start": {"team": "mlb:15", "team_league": "mlb", "mode": 5, "favs": ["nhl:25", "", "", ""]}, "set": [["team", "none"]],
     "expect": {"team": "", "live": ["mlb", "nhl"], "live_auto": true}},
    {"name": "a fresh panel's NFL counts with no team", "start": {"team": "", "team_league": "nfl", "mode": 5, "favs": ["mlb:15", "", "", ""]}, "set": [["live", ""]],
     "expect": {"live": ["nfl", "mlb"], "live_auto": true}},

    {"name": "no team in My team reports every league", "set": [["team", "none"]], "expect": {"team": "", "live": ["nfl", "ncaa", "mlb", "mls", "epl", "nba", "wnba", "mcbb", "nhl"], "live_auto": true}},
    {"name": "no team keeps every league over a saved list", "start": {"team": "", "live": ["mlb"], "live_auto": false}, "set": [["rotate", "5"]],
     "expect": {"live": ["nfl", "ncaa", "mlb", "mls", "epl", "nba", "wnba", "mcbb", "nhl"], "live_auto": false}},
    {"name": "Favorites with none set and no team reports every league", "start": {"team": "", "mode": 4}, "set": [["rotate", "5"]], "expect": {"live": ["nfl", "ncaa", "mlb", "mls", "epl", "nba", "wnba", "mcbb", "nhl"]}},
    {"name": "a favorite in Favorites ends the no-team set", "start": {"team": "", "mode": 4}, "set": [["fav1", "nhl:25"]], "expect": {"live": ["nfl", "nhl"]}},
    {"name": "a team ends the no-team set", "start": {"team": ""}, "set": [["team", "mlb:15"]], "expect": {"team": "mlb:15", "live": ["mlb"]}},
    {"name": "Live games ends the no-team set", "start": {"team": "", "team_league": "nfl"}, "set": [["mode", "5"]], "expect": {"mode": 5, "live": ["nfl"]}},

    {"name": "two panels", "set": [["panels", "2"]], "expect": {"panels": 2}},
    {"name": "zero panels is refused", "start": {"panels": 2}, "set": [["panels", "0"]], "expect": {"panels": 2}},
    {"name": "more panels than the build drives is refused", "set": [["panels", "3"]], "expect": {"panels": 1}},

    {"name": "no known key answers 400", "start": {"rotate": 5}, "set": [["bogus", "1"]], "status": 400, "expect": {"rotate": 5}},
    {"name": "unknown keys next to known ones are skipped", "set": [["bogus", "1"], ["rotate", "5"]], "expect": {"rotate": 5}},
    {"name": "one refused key doesn't stop the rest", "set": [["mode", "9"], ["rotate", "5"], ["tz", "Mars"]], "expect": {"mode": 0, "rotate": 5, "tz": 1}},
    {"name": "a message card's text", "set": [["msg", "Happy birthday, Sam!"]], "expect": {"msg": "Happy birthday, Sam!"}},
    {"name": "message lines are trimmed and blank ones dropped", "set": [["msg", "  Wings $5 \r\n\n\tPints $3  \n"]], "expect": {"msg": "Wings $5\nPints $3"}},
    {"name": "emoji are left out of a message", "set": [["msg", "Happy birthday 🎂 Sam"]], "expect": {"msg": "Happy birthday Sam"}},
    {"name": "a message is cut at 200 bytes", "set": [["msg", "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"]], "expect": {"msg": "01234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"}},
    {"name": "an empty message clears it", "start": {"msg": "Pizza's here"}, "set": [["msg", ""]], "expect": {"msg": ""}},
    {"name": "a list address", "set": [["msgurl", "http://192.168.1.20/names.txt"]], "expect": {"msgurl": "http://192.168.1.20/names.txt"}},
    {"name": "a list address that isn't http is refused", "start": {"msgurl": "https://example.com/a.txt"}, "set": [["msgurl", "file:///etc/passwd"]], "expect": {"msgurl": "https://example.com/a.txt"}},
    {"name": "an empty list address clears it", "start": {"msgurl": "https://example.com/a.txt"}, "set": [["msgurl", ""]], "expect": {"msgurl": ""}},
    {"name": "msgevery 0 holds the board between games", "set": [["msgevery", "0"]], "expect": {"msgevery": 0}},
    {"name": "msgevery past 30 is 30", "set": [["msgevery", "45"]], "expect": {"msgevery": 30}},
    {"name": "msgevery as text is refused", "start": {"msgevery": 5}, "set": [["msgevery", "soon"]], "expect": {"msgevery": 5}},

    {"name": "night schedule on with its hours", "set": [["night", "1"], ["nightstart", "22:30"], ["nightend", "6:15"]],
     "expect": {"night": true, "nightstart": "22:30", "nightend": "06:15"}},
    {"name": "night schedule off keeps its hours", "start": {"night": true, "nightstart": "21:00"}, "set": [["night", "0"]],
     "expect": {"night": false, "nightstart": "21:00"}},
    {"name": "screen off at night", "set": [["nightscreen", "0"]], "expect": {"nightscreen": false}},
    {"name": "screen back on at night", "start": {"nightscreen": false}, "set": [["nightscreen", "1"]], "expect": {"nightscreen": true}},
    {"name": "night brightness", "set": [["nightlevel", "40"]], "expect": {"nightlevel": 40}},
    {"name": "night brightness 0 is 1", "set": [["nightlevel", "0"]], "expect": {"nightlevel": 1}},
    {"name": "night brightness past 255 is 255", "set": [["nightlevel", "900"]], "expect": {"nightlevel": 255}},
    {"name": "a night time past 23:59 is refused", "set": [["nightstart", "24:00"], ["nightend", "07:60"]],
     "expect": {"nightstart": "23:00", "nightend": "07:00"}},
    {"name": "a night time with AM or PM is refused", "set": [["nightstart", "11 PM"]], "expect": {"nightstart": "23:00"}},
    {"name": "midnight starts the night", "set": [["nightstart", "00:00"]], "expect": {"nightstart": "00:00"}},
    {"name": "lists sets playlists over the favorites", "start": {"favs": ["nfl:6", "nba:6", "nhl:25", "mlb:15"]}, "set": [["lists", "Football=nfl:6;Dallas=nfl:6,nba:6,nhl:25"]], "expect": {"lists": [{"n": "Football", "f": [0]}, {"n": "Dallas", "f": [0, 1, 2]}], "list": 0}},
    {"name": "a playlist keeps only favorites", "start": {"favs": ["nfl:6", "nba:6", "nhl:25", "mlb:15"]}, "set": [["lists", "Mix=nfl:6,nfl:21,nfl:99999,bogus,nfl:6"]], "expect": {"lists": [{"n": "Mix", "f": [0]}]}},
    {"name": "a playlist with no name is left out", "start": {"favs": ["nfl:6", "nba:6", "nhl:25", "mlb:15"]}, "set": [["lists", "=nfl:6;  =nba:6;Hockey=nhl:25"]], "expect": {"lists": [{"n": "Hockey", "f": [2]}]}},
    {"name": "a playlist name is cut to 16 bytes", "start": {"favs": ["nfl:6", "nba:6", "nhl:25", "mlb:15"]}, "set": [["lists", "Sunday Football Crew=nfl:6"]], "expect": {"lists": [{"n": "Sunday Football", "f": [0]}]}},
    {"name": "favs in the same request come first", "start": {"favs": ["", "", "", ""]}, "set": [["lists", "Two=nba:6,mlb:15"], ["favs", "mlb:15,nba:6"]], "expect": {"lists": [{"n": "Two", "f": [0, 1]}]}},
    {"name": "list plays a playlist in Favorite teams", "start": {"favs": ["nfl:6", "nba:6", "nhl:25", "mlb:15"], "lists": [{"n": "A", "f": [0]}, {"n": "B", "f": [1]}]}, "set": [["list", "2"]], "expect": {"list": 2, "mode": 4}},
    {"name": "list 0 is every favorite", "start": {"favs": ["nfl:6", "nba:6", "nhl:25", "mlb:15"], "mode": 4, "lists": [{"n": "A", "f": [0]}], "list": 1}, "set": [["list", "0"]], "expect": {"list": 0, "mode": 4}},
    {"name": "list past the last playlist is refused", "start": {"favs": ["nfl:6", "nba:6", "nhl:25", "mlb:15"], "lists": [{"n": "A", "f": [0]}]}, "set": [["list", "2"]], "expect": {"list": 0, "mode": 0}},
    {"name": "list too long for a number is refused", "start": {"favs": ["nfl:6", "nba:6", "nhl:25", "mlb:15"], "lists": [{"n": "A", "f": [0]}], "list": 1}, "set": [["list", "19999999999"]], "expect": {"list": 1}},
    {"name": "list that isn't a number is refused", "start": {"favs": ["nfl:6", "nba:6", "nhl:25", "mlb:15"], "lists": [{"n": "A", "f": [0]}], "list": 1}, "set": [["list", "abc"]], "expect": {"list": 1}},
    {"name": "the playing playlist stays chosen by name", "start": {"favs": ["nfl:6", "nba:6", "nhl:25", "mlb:15"], "lists": [{"n": "A", "f": [0]}, {"n": "B", "f": [1]}], "list": 2}, "set": [["lists", "B=nba:6;A=nfl:6"]], "expect": {"list": 1}},
    {"name": "renaming the playing playlist with list keeps it", "start": {"favs": ["nfl:6", "nba:6", "nhl:25", "mlb:15"], "lists": [{"n": "A", "f": [0]}], "list": 1}, "set": [["lists", "Z=nfl:6"], ["list", "1"]], "expect": {"lists": [{"n": "Z", "f": [0]}], "list": 1}},
    {"name": "the playing playlist gone is every favorite", "start": {"favs": ["nfl:6", "nba:6", "nhl:25", "mlb:15"], "lists": [{"n": "A", "f": [0]}, {"n": "B", "f": [1]}], "list": 1}, "set": [["lists", "B=nba:6"]], "expect": {"list": 0}},
    {"name": "lists empty clears them", "start": {"favs": ["nfl:6", "nba:6", "nhl:25", "mlb:15"], "lists": [{"n": "A", "f": [0]}], "list": 1}, "set": [["lists", ""]], "expect": {"lists": [], "list": 0}},
    {"name": "reordered favorites keep their playlists", "start": {"favs": ["nfl:6", "nba:6", "nhl:25", "mlb:15"], "lists": [{"n": "A", "f": [0, 2]}]}, "set": [["favs", "nhl:25,mlb:15,nfl:6"]], "expect": {"lists": [{"n": "A", "f": [0, 2]}]}},
    {"name": "a favorite taken out leaves its playlists", "start": {"favs": ["nfl:6", "nba:6", "nhl:25", "mlb:15"], "lists": [{"n": "A", "f": [0, 1]}]}, "set": [["favs", "nba:6,nhl:25"]], "expect": {"lists": [{"n": "A", "f": [0]}]}},
    {"name": "a fav slot replaced leaves its playlists", "start": {"favs": ["nfl:6", "nba:6", "nhl:25", "mlb:15"], "lists": [{"n": "A", "f": [0, 1]}]}, "set": [["fav1", "nfl:21"]], "expect": {"lists": [{"n": "A", "f": [1]}]}}
  ]
}
